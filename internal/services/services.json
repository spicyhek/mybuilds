{
  "services": [
    {
      "name": "personal-site",
      "environment": "production",
      "repository": "spicyhek/homelab-hosted-personal-site",
      "workflow": ".github/workflows/release.yml",
      "branch": "main",
      "argocd_application": "personal-site",
      "gitops_repository": "spicyhek/homelab-infra",
      "gitops_path": "k8s/apps/personal-site",
      "artifact": "ghcr.io/spicyhek/homelab-hosted-personal-site",
      "jobs": {
        "build": {
          "stage": "build",
          "from_step": [{ "step": "Push image", "stage": "publish" }]
        },
        "bump-gitops": { "stage": "gitops" }
      },
      "workload": { "namespace": "default", "deployment": "personal-site" }
    }
  ]
}
